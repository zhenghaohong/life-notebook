[Unit]
Description=Life Notebook isolated HTTPS gateway
After=network-online.target life-notebook.service

[Service]
User=life-notebook-web
Group=life-notebook-web
Environment=HOME=/var/lib/life-notebook-web
ExecStart=/opt/life-notebook/bin/caddy run --config /opt/life-notebook/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/life-notebook-web
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
